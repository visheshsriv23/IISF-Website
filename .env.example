# Public site URL (used for metadata, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings → API. The service-role key stays on the server; never prefix it with NEXT_PUBLIC_.
# Leave empty to run on placeholder seed content (read-only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel (/admin)
ADMIN_PASSWORD=change-me
# Any long random string: `openssl rand -base64 32`
SESSION_SECRET=

# Optional: email notifications for new submissions (https://resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=

# Optional: Plausible analytics domain, e.g. iisf.knit.ac.in
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
